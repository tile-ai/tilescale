FROM rocm/pytorch:rocm7.2_ubuntu22.04_py3.10_pytorch_release_2.10.0

WORKDIR /root

RUN echo "LC_ALL=en_US.UTF-8" >> /etc/environment

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
  build-essential git wget \
  libgtest-dev libprotobuf-dev protobuf-compiler libgflags-dev libsqlite3-dev llvm-dev \
  rocm-dev rocm-libs hip-dev hipblas-dev rocblas-dev \
  && apt-get clean autoclean && rm -rf /var/lib/apt/lists/{cache,log} /tmp/* /var/tmp/*

ENV LIBGL_ALWAYS_INDIRECT=1
ENV USE_ROCM=1
ENV USE_CUDA=0
ENV ROCM_HOME=/opt/rocm
ENV HIP_PLATFORM=amd
ENV PYTORCH_ROCM_ARCH="gfx90a;gfx942;gfx950;gfx1201;gfx1100"

RUN apt-get update && apt-get install -y python3 python3-dev python3-setuptools gcc libtinfo-dev zlib1g-dev build-essential cmake libedit-dev libxml2-dev && \
    apt-get clean autoclean && rm -rf /var/lib/apt/lists/{cache,log} /tmp/* /var/tmp/*

RUN pip install --no-cache-dir \
    "apache-tvm-ffi==0.1.11" \
    cloudpickle \
    ml-dtypes \
    "numpy>=1.23.5,<2.0" \
    psutil \
    "tqdm>=4.62.3" \
    "typing-extensions>=4.10.0" \
    "z3-solver>=4.13.0,<4.15.5"

COPY . /root/TileScale

# The base image already provides a ROCm-enabled torch. Avoid resolving the
# CUDA-only torch-c-dlpack-ext dependency while retaining isolated build deps.
RUN cd /root/TileScale && \
    TVM_FFI_DISABLE_TORCH_C_DLPACK=1 USE_ROCM=1 USE_CUDA=0 \
    pip install . --no-deps -v

SHELL ["/bin/bash", "-l", "-c"]

ENTRYPOINT ["/bin/bash", "--login", "-i"]
